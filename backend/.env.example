# IPovtich API - copy to .env, fill in values, never commit .env.
# Load with Uvicorn: uvicorn app.main:app --env-file .env --host 0.0.0.0 --port 8001
# Or: export $(grep -v '^#' .env | xargs) before starting your process.
# Docker Compose: env_file: .env

# --- Optional limits ---
# MAX_UPLOAD_BYTES=10485760

# --- CORS (comma-separated full origins, no wildcards) ---
# CORS_ORIGINS=https://ipovtich.example.com,https://ipovtich.example.com:443

# --- Static API key (scripts, non-browser clients) ---
# IPOVITCH_API_KEY=

# --- JWT dashboard login (set secret + ONE of password or hash) ---
# IPOVITCH_JWT_SECRET=change-me-minimum-32-characters-long-secret
# IPOVITCH_LOGIN_PASSWORD=
# IPOVITCH_LOGIN_PASSWORD_HASH=
# IPOVITCH_JWT_TTL_SECONDS=28800

# --- Hardening ---
# IPOVITCH_OPENAPI_ENABLED=0
# IPOVITCH_RATE_LIMIT_PER_MINUTE=120
# IPOVITCH_LOGIN_RATE_PER_MINUTE=20
# IPOVITCH_HSTS_MAX_AGE=31536000
