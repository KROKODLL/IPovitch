# IPovtich web UI - copy to .env.local (or .env) for production builds.
# Only variables prefixed with VITE_ are exposed to the client.

# API origin (no path). Example: https://api.ipovtich.example.com
# VITE_API_BASE=https://api.example.com

# Optional: same value as backend IPOVITCH_API_KEY (embedded in bundle; not secret).
# Prefer signing in via the UI when the API uses JWT.
# VITE_API_KEY=
